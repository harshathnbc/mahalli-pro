# ===========================================================================
# Mahalli Pro V4 — environment template. Copy to backend/.env and fill in.
# Phase 0 = DigitalOcean (dev, synthetic data only). Phase 1 = GCP Dammam.
# ===========================================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL 16 + pgvector, pg_trgm, pgcrypto) ---
# App connects as a NON-superuser role so Row-Level Security is enforced.
DATABASE_URL=postgres://mahalli_app:app_pw@localhost:5432/mahalli
# Privileged role used only by the Master Admin control center (RLS bypass).
DATABASE_URL_ADMIN=postgres://mahalli_admin:admin_pw@localhost:5432/mahalli

# --- Field-level encryption (AES-256-GCM) ---
# 32-byte urlsafe-base64 key. Phase 1: store as a KMS-wrapped DEK in Secret Manager.
# Generate: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=

# --- Redis (broker + cache + sessions) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (Phase 0: DO Spaces S3) ---
STORAGE_BUCKET=mahalli-dev
STORAGE_ENDPOINT_URL=https://fra1.digitaloceanspaces.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=fra1

# --- Google Cloud (Vertex AI + Document AI — me-central2 in BOTH phases) ---
GCP_PROJECT_ID=
GCP_LOCATION=me-central2
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-service-account.json
DOCAI_PROCESSOR_ID=
VERTEX_EMBEDDING_MODEL=text-embedding-004
VERTEX_GENERATIVE_MODEL=gemini-1.5-flash

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
